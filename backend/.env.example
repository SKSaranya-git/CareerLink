# Server
PORT=5000
NODE_ENV=development

# Database (required in production — Railway often provides DATABASE_URL from a Mongo plugin)
MONGO_URI=mongodb://127.0.0.1:27017/jobboard
# DATABASE_URL=   # optional alternative on Railway / Render
# MONGODB_URI=    # optional alternative name some hosts use

# Auth
JWT_SECRET=your_super_secret_jwt_key

# Admin registration (Register as Administrator on the frontend)
ADMIN_INVITE_CODE=change-me-to-a-secret-phrase

# Frontend (CORS)
CLIENT_URL=http://localhost:5173

# Email (Nodemailer SMTP)
# Option A: service (e.g., Gmail). For Gmail, use an App Password.
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Option B: host/port (uncomment if you prefer this approach)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Email sender (optional; defaults to SMTP_USER)
EMAIL_FROM="JobBoard <no-reply@jobboard.local>"

