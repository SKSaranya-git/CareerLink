{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "set NODE_ENV=test && jest --runInBand --testPathIgnorePatterns=/integration/",
    "test:unit": "set NODE_ENV=test && jest --runInBand src/utils/__tests__",
    "test:integration": "set NODE_ENV=test && jest --runInBand --testPathPatterns=integration",
    "test:perf": "npx --yes artillery@2.0.30 run artillery.yml",
    "migrate:jobs": "node scripts/migrateJobsSchema.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
